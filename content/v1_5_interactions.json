{
  "_about": "HOW each V1.5 encounter is played. The encounter pack defines WHAT is learned (ideas, correct answers, reveals, mastery, points); this layer re-expresses an encounter as a lighter interaction. Every option, label and verdict here is a shortened restatement of that encounter's own correct answer, distractors, or reveal — no new claims. Encounters not listed keep their pack form. The pack's reveal is always shown after the player acts.",
  "_forms": {
    "binary": "SAME THING? / THIS · THAT / PICK ONE OF TWO — a small stage, one short question, two answers.",
    "pick": "SHORT SCENARIO → PICK CONCEPT / COMPLETE THE CONNECTION — a small stage and three short options.",
    "sort": "Place short items into two or three bins (LEAVE · REFORM · BUILD, REPRESENTATION · SELF-DETERMINATION…).",
    "recall": "THINK FIRST → REVEAL: the pack's correct answer becomes the revealed answer; the player self-rates.",
    "lens": "Optional recurring question shown quietly above the card (WHO IS “WE”?, WHO DECIDES?, …)."
  },
  "discover": {
    "D045": { "statement": "Meet their standards. Get protection?", "reveal": "Respectability is a strategy—or an expectation—that meeting dominant standards can buy legitimacy, protection, or opportunity. It has real uses, and real limits." },
    "D046": { "statement": "Ending something is only half the question.", "ask": "What replaces it?", "reveal": "Abolition asks what must end—and what must be built in its place." },
    "D047": { "statement": "Representation asks who is present. Self-determination asks who can decide.", "reveal": "Black nationalism is a varied tradition of self-determination: territory, political unity, economic control, culture, independent institutions—or combinations of these.", "lens": "WHO IS “WE”?" },
    "D048": { "statement": "Diaspora describes connection.", "ask": "What turns it into organized solidarity?", "reveal": "Pan-Africanism tries to turn global Black connection into organized solidarity across borders." },
    "D049": { "statement": "Before punishment comes a decision about who looks punishable.", "reveal": "Criminalization is how laws, institutions, media, and stories define some people as dangerous—and so more punishable." },
    "D050": { "statement": "The door opens. On whose terms?", "reveal": "Predatory inclusion is access granted on unequal or exploitative terms. Getting in matters. So do the terms of entry." }
  },
