    {
      "id": "V1-025",
      "item": "The Great Migration",
      "type": "CORE",
      "world": "FREEDOM",
      "placement": "LEAD",
      "text": "For decades, Black Americans have been moving back to the South, reversing the old Great Migration—with younger and college-educated people especially prominent. From 2015 to 2020, Texas, Georgia, and North Carolina were major destinations, and Atlanta gained more Black migrants than anywhere else.",
      "bridge": "A century ago, millions left the South because place decided their safety, wages, and political possibility; today Brookings points to family, jobs, and Black middle-class communities as reasons many are choosing the South again.",
      "sourceTitle": "A 'New Great Migration' is bringing Black Americans back to the South",
      "sourcePublisher": "Brookings Institution (William H. Frey)",
      "sourceURL": "https://www.brookings.edu/articles/a-new-great-migration-is-bringing-black-americans-back-to-the-south/",
      "sourceDate": "2022-09-12",
      "refreshBy": "2027-09",
      "verification": "Facts verified externally by the project owner; source could not be opened from the build environment."
    },
    {
      "id": "V1-036",
      "item": "Malcolm X",
      "type": "CORE",
      "world": "FREEDOM",
      "placement": "CODA",
      "text": "In 2021, the UN High Commissioner for Human Rights presented a report and four-point agenda for racial justice, addressing systemic racism and law-enforcement abuses against Africans and people of African descent. It drew on international human-rights mechanisms and consultation with people of African descent.",
      "bridge": "Malcolm X insisted that Black freedom could not be confined to U.S. citizenship; this report handles the same injustices as an international human-rights question.",
      "sourceTitle": "A/HRC/47/CRP.1 — report on systemic racism, law enforcement, and Africans and people of African descent (conference room paper)",
      "sourcePublisher": "United Nations, Office of the High Commissioner for Human Rights (OHCHR)",
      "sourceURL": "https://www.ohchr.org/sites/default/files/Documents/Issues/Racism/A_HRC_47_CRP_1.pdf",
      "sourceDate": "2021",
      "refreshBy": "2027-10",
      "additionalSources": [
        {
          "sourceTitle": "OHCHR Report 2021",
          "sourcePublisher": "United Nations, OHCHR",
          "sourceURL": "https://www.ohchr.org/sites/default/files/2022-06/OHCHR_Report_2021.pdf",
          "sourceDate": "2022"
        }
      ],
      "verification": "Facts verified externally by the project owner; source could not be opened from the build environment."
    },
    {
      "id": "V1-046",
      "item": "Abolition",
      "type": "CORE",
      "world": "FREEDOM",
      "placement": "CODA",
      "text": "In 2022, voters in Oregon, Tennessee, and Vermont removed constitutional language allowing slavery or involuntary servitude as punishment, and Alabama's recompiled constitution dropped its own exception. Louisiana voters rejected a related measure—its own original sponsor had urged a no vote because he found the final wording confusing.",
      "bridge": "Deleting the exception ended a legal permission, but it did not decide what should happen to prison labor—the second half of abolition's question: what replaces it?",
      "sourceTitle": "State Elections 2022",
      "sourcePublisher": "National Conference of State Legislatures",
      "sourceURL": "https://www.ncsl.org/elections/state-elections-2022",
      "sourceDate": "2022",
      "refreshBy": "2027-10",
      "additionalSources": [
        {
          "sourceTitle": "Top Trends in Criminal Justice Reform, 2022",
          "sourcePublisher": "The Sentencing Project",
          "sourceURL": "https://www.sentencingproject.org/fact-sheet/top-trends-in-criminal-justice-reform-2022/",
          "sourceDate": "2022"
        }
      ],
      "verification": "Facts verified externally by the project owner; source could not be opened from the build environment."
    }
